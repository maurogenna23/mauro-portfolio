---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Not found — Mauro Genna" description="That page does not exist." noindex>
  <main class="wrap hero">
    <p class="hero__role">404</p>
    <h1 class="display">That page does not exist.</h1>
    <p class="hero__sub">
      The link may be old, or the address may have a typo. Everything lives on one page.
    </p>
    <div class="actions">
      <a class="action" href="/">Go to the portfolio</a>
      <a class="action action--quiet" href="/#contact">Get in touch</a>
    </div>
  </main>
</Layout>
