---
import Layout from '../layouts/Layout.astro';
import WaveBackground from '../components/three/WaveBackground.tsx';
---

<Layout>
  <!-- 3D flowing colour-wave background (client-only WebGL island) -->
  <WaveBackground client:only="react" />

  <div class="page">
    <header class="nav">
      <a class="brand" href="#top"><span class="mark"></span> Mauro Genna</a>
      <nav class="links">
        <a href="#work">Work</a>
        <a href="#skills">Skills</a>
        <a href="#experience">Experience</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="btn btn-primary" href="#contact">Get in touch</a>
    </header>

    <section class="hero" id="top">
      <span class="eyebrow">AI Engineer &amp; Full-Stack Developer · Founder of Arnie</span>
      <h1>From the <em>agent</em><br />to the <em>interface</em>.</h1>
      <p class="lead">
        I ship production AI — agentic assistants, RAG pipelines and voice
        automation — plus the polished frontends that make them usable.
      </p>

      <div class="prompt">
        <input
          class="prompt-input"
          type="text"
          placeholder="Ask my AI anything about my experience…"
          aria-label="Ask my AI"
          readonly
        />
        <button class="prompt-send" aria-label="Send">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
            <path d="M5 12h13M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <div class="hero-cta">
        <a class="btn btn-primary" href="#work">See my work</a>
        <a class="btn btn-ghost" href="#contact">Download CV</a>
      </div>
    </section>

    <section class="section" id="work">
      <div class="container">
        <div class="sec-head" data-reveal>
          <span class="eyebrow">Selected work</span>
          <h2 class="sec-title">Products, not paperwork.</h2>
          <p class="sec-sub">
            Real systems I designed and shipped — the AI, the retrieval layer,
            the backend, and the frontend around them.
          </p>
        </div>

        <div class="work-grid">
          <article class="card big" data-card>
            <div class="card-k">Founder · 2026 → now</div>
            <h3>Arnie — 24/7 AI customer support</h3>
            <p>
              A B2B platform answering customers over WhatsApp, voice and web
              chat. Two assistants share a context engine — PDF/website
              ingestion, chunking, Postgres full-text + trigram retrieval — with
              per-tenant isolation and agents that take real actions via
              function calling.
            </p>
            <div class="tags">
              <span class="tag">OpenAI</span><span class="tag">Function calling</span>
              <span class="tag">RAG</span><span class="tag">NestJS</span>
              <span class="tag">Next.js</span><span class="tag">Retell AI</span>
            </div>
            <div class="impact"><b>Live</b> · arniechat.com — built &amp; shipped solo</div>
          </article>

          <article class="card" data-card>
            <div class="card-k">Software Engineer · Ad-tech SaaS</div>
            <h3>Role-based multi-agent AI</h3>
            <p>
              Four assistants over one production DB with different permissions.
              A propose/execute pattern — model proposes, human confirms, system
              executes — plus a scoped read-only SQL sandbox.
            </p>
            <div class="tags">
              <span class="tag">Multi-agent</span><span class="tag">Guardrails</span><span class="tag">SQL sandbox</span>
            </div>
          </article>

          <article class="card" data-card>
            <div class="card-k">Full-Stack Engineer · Proptech</div>
            <h3>Voice-AI incident automation</h3>
            <p>
              A voice pipeline on Retell AI turning resident calls into
              structured incident records and triggering email / SMS / admin
              workflows — no human transcription in the loop.
            </p>
            <div class="tags">
              <span class="tag">Voice AI</span><span class="tag">Retell</span><span class="tag">Automation</span>
            </div>
            <div class="impact"><b>50+</b> residential properties in Spain</div>
          </article>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  :root {
    --ink: #eaf0ff;
    --muted: #9ba7c6;
    --faint: #616e90;
    --line: rgba(120, 160, 255, 0.14);
    --line-2: rgba(120, 160, 255, 0.26);
    --surface: rgba(120, 160, 255, 0.06);
    --accent-1: #5b9bff;
    --accent-2: #2a46c8;
    --sans: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", system-ui, sans-serif;
    --mono: ui-monospace, "SF Mono", "SFMono-Regular", Menlo, monospace;
  }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: #050912; /* deep navy fallback behind the WebGL canvas */
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    letter-spacing: -0.012em;
    overflow-x: hidden;
  }
  body a { color: inherit; text-decoration: none; }
  ::selection { background: var(--accent-1); color: #061024; }
</style>

<style>
  .page { position: relative; z-index: 1; }

  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 40;
    display: flex; align-items: center; justify-content: space-between;
    height: 62px; padding: 0 clamp(20px, 5vw, 44px);
  }
  .brand { display: flex; align-items: center; gap: 10px; font-weight: 640; letter-spacing: -0.02em; }
  .brand .mark {
    width: 12px; height: 12px; border-radius: 4px;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
    box-shadow: 0 0 16px -2px var(--accent-1);
  }
  .links { display: flex; gap: 26px; }
  .links a { font-size: 14px; color: var(--muted); transition: color 0.15s; }
  .links a:hover { color: var(--ink); }
  @media (max-width: 760px) { .links { display: none; } }

  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    font: 550 14px var(--sans); padding: 11px 18px; border-radius: 12px;
    cursor: pointer; border: 1px solid var(--line-2);
    background: var(--surface); color: var(--ink);
    transition: transform 0.12s, background 0.2s, border-color 0.2s, box-shadow 0.2s;
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary {
    border: 0; color: #fff; font-weight: 600;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
  }
  .btn-primary:hover { box-shadow: 0 12px 30px -10px color-mix(in oklab, var(--accent-1) 75%, transparent); }
  .btn-ghost:hover { border-color: var(--line-2); background: rgba(120, 160, 255, 0.1); }

  .hero {
    min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    text-align: center; gap: 0;
    padding: 120px clamp(20px, 5vw, 44px) 80px;
  }
  .eyebrow {
    font-family: var(--mono); font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase;
    color: transparent; background: linear-gradient(90deg, var(--accent-1), #a9c7ff);
    -webkit-background-clip: text; background-clip: text;
  }
  .hero h1 {
    margin: 22px 0 0; font-size: clamp(44px, 7.4vw, 92px); font-weight: 500;
    line-height: 1.02; letter-spacing: -0.04em; text-wrap: balance;
    text-shadow: 0 4px 40px rgba(0, 0, 0, 0.5);
  }
  .hero h1 em {
    font-style: normal; color: transparent;
    background: linear-gradient(120deg, var(--accent-1), #a9c7ff);
    -webkit-background-clip: text; background-clip: text;
  }
  .hero .lead {
    margin: 22px auto 0; max-width: 46ch; color: var(--muted);
    font-size: clamp(15px, 1.7vw, 18px); text-shadow: 0 2px 20px rgba(0, 0, 0, 0.4);
  }

  .prompt {
    display: flex; align-items: center; gap: 8px;
    margin: 38px auto 0; width: min(560px, 100%);
    padding: 8px 8px 8px 18px; border-radius: 16px;
    background: rgba(8, 14, 30, 0.55); border: 1px solid var(--line-2);
    box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.06);
    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
  }
  .prompt-input {
    flex: 1; background: transparent; border: 0; outline: none;
    color: var(--ink); font: 15px var(--sans); padding: 10px 0;
  }
  .prompt-input::placeholder { color: var(--faint); }
  .prompt-send {
    flex: none; width: 40px; height: 40px; border-radius: 11px; border: 0; cursor: pointer;
    display: grid; place-items: center; color: #fff;
    background: linear-gradient(135deg, var(--accent-1), var(--accent-2));
  }

  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 26px; }

  /* ---- sections ---- */
  .section { position: relative; padding: clamp(90px, 14vh, 165px) 0; }
  .container { width: 100%; max-width: 1080px; margin: 0 auto; padding: 0 clamp(20px, 5vw, 44px); }
  .sec-head { max-width: 640px; }
  .sec-title { font-size: clamp(30px, 4.6vw, 52px); font-weight: 540; letter-spacing: -0.035em; line-height: 1.05; margin: 16px 0 0; text-wrap: balance; }
  .sec-sub { color: var(--muted); margin-top: 14px; font-size: 15.5px; max-width: 54ch; }

  .work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 46px; perspective: 1200px; }
  @media (max-width: 820px) { .work-grid { grid-template-columns: 1fr; } }
  .card {
    padding: 26px clamp(22px, 3vw, 30px); border-radius: 18px;
    background: rgba(10, 17, 34, 0.5); border: 1px solid var(--line);
    -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: 0 24px 60px -34px rgba(0, 0, 0, 0.8);
    transform-style: preserve-3d;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1), border-color 0.3s, box-shadow 0.3s;
  }
  .card.big { grid-column: 1 / -1; }
  .card:hover { transform: translateY(-5px); border-color: var(--line-2); box-shadow: 0 40px 70px -30px rgba(0, 0, 0, 0.85); }
  .card-k { font: 11px var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--faint); }
  .card h3 { font-size: clamp(19px, 2.2vw, 23px); letter-spacing: -0.02em; font-weight: 600; margin: 10px 0 0; }
  .card p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin-top: 12px; max-width: 62ch; }
  .tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 18px; }
  .tag { font: 11.5px var(--mono); color: var(--muted); border: 1px solid var(--line); border-radius: 6px; padding: 4px 8px; }
  .impact { margin-top: 16px; font-size: 13.5px; color: var(--ink); font-weight: 500; }
  .impact b {
    font-family: var(--mono); color: transparent;
    background: linear-gradient(90deg, var(--accent-1), #a9c7ff);
    -webkit-background-clip: text; background-clip: text;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce) {
    gsap.registerPlugin(ScrollTrigger);

    // section heads: children rise in, staggered
    (gsap.utils.toArray('[data-reveal]') as HTMLElement[]).forEach((el) => {
      gsap.from(el.children, {
        y: 34,
        opacity: 0,
        duration: 0.8,
        ease: 'power3.out',
        stagger: 0.09,
        scrollTrigger: { trigger: el, start: 'top 82%' },
      });
    });

    // work cards: 3D swing-in
    (gsap.utils.toArray('[data-card]') as HTMLElement[]).forEach((el) => {
      gsap.from(el, {
        y: 70,
        opacity: 0,
        rotateX: -22,
        transformPerspective: 900,
        transformOrigin: 'center top',
        duration: 0.95,
        ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 88%' },
      });
    });
  }
</script>
