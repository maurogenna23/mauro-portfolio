---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div
    data-portfolio-root
    style="--bg:#080a0f;--bg-soft:#0b0e15;--panel:#0d111a;--panel-2:#10141e;--line:rgba(122,160,224,.14);--line-2:rgba(122,160,224,.30);--ink:#e8edf5;--muted:#93a0b6;--faint:#6a7688;--accent:#4d9bff;--grid-op:1;--node-play:running;--grain-op:.045;--sp-eyebrow:20px;--sp-lead:22px;--sp-para:16px;--sp-block:32px;--sans:'Space Grotesk',system-ui,sans-serif;--mono:'IBM Plex Mono',ui-monospace,monospace;position:relative;min-height:100vh;background:var(--bg);color:var(--ink);font-family:var(--sans);-webkit-font-smoothing:antialiased;overflow-x:clip"
  >
    <div
      data-boot
      aria-hidden="true"
      style="position:fixed;inset:0;z-index:99990;display:flex;flex-direction:column;justify-content:center;background:#05070d;font-family:var(--mono);padding:0 clamp(24px,8vw,96px);transition:opacity .42s ease,transform .42s cubic-bezier(.4,0,.2,1);will-change:opacity,transform"
    >
      <div style="width:100%;max-width:640px;color:var(--accent);font-size:clamp(13px,2.3vw,16.5px);line-height:2.05">
        <div data-boot-line style="min-height:1.7em;white-space:nowrap"></div>
        <div data-boot-line style="min-height:1.7em;white-space:nowrap"></div>
        <div data-boot-line style="min-height:1.7em;white-space:nowrap"></div>
        <div data-boot-line style="min-height:1.7em;white-space:nowrap"></div>
      </div>
      <div style="position:absolute;left:0;right:0;bottom:34px;text-align:center;font-family:var(--mono);font-size:10.5px;letter-spacing:.18em;color:var(--faint)">PRESS ANY KEY OR CLICK TO SKIP</div>
    </div>

    <div aria-hidden="true" style="position:fixed;inset:0;z-index:0;pointer-events:none;opacity:var(--grid-op,1);background-image:linear-gradient(rgba(122,160,224,.05) 1px,transparent 1px),linear-gradient(90deg,rgba(122,160,224,.05) 1px,transparent 1px),linear-gradient(rgba(122,160,224,.09) 1px,transparent 1px),linear-gradient(90deg,rgba(122,160,224,.09) 1px,transparent 1px);background-size:34px 34px,34px 34px,170px 170px,170px 170px;background-position:center;-webkit-mask-image:radial-gradient(150% 120% at 50% 0%,#000 52%,transparent 100%);mask-image:radial-gradient(150% 120% at 50% 0%,#000 52%,transparent 100%)"></div>
    <div aria-hidden="true" style="position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(75% 55% at 50% -10%,color-mix(in oklab,var(--accent) 13%,transparent),transparent 68%)"></div>

    <div style="position:relative;z-index:1">
      <header style="position:sticky;top:0;z-index:30;background:color-mix(in oklab,var(--bg) 84%,transparent);backdrop-filter:blur(14px) saturate(1.15);-webkit-backdrop-filter:blur(14px) saturate(1.15);border-bottom:1px solid var(--line)">
        <div style="display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;max-width:1280px;margin:0 auto;min-height:62px;padding:0 clamp(16px,5vw,56px)">
          <a href="#top" data-cursor-hot style="justify-self:start;display:flex;align-items:center;gap:13px;min-width:0">
            <span style="display:flex;flex-direction:column;line-height:1.04;min-width:0">
              <span class="hdr-name" style="font-family:var(--sans);font-size:17px;font-weight:600;letter-spacing:-.01em;color:var(--ink)">Mauro Genna</span>
              <span data-hdr-role style="font-family:var(--mono);font-size:9px;letter-spacing:.2em;color:var(--faint);text-transform:uppercase;margin-top:4px">AI Integration Engineer</span>
            </span>
          </a>
          <nav class="hdr-nav" style="justify-self:center;display:flex;align-items:stretch;height:36px;border:1px solid var(--line-2);border-radius:10px;background:color-mix(in oklab,var(--bg-soft) 55%,transparent);overflow:hidden;font-family:var(--mono);font-size:12px">
            <a class="hover-nav" data-nav="arnie" href="#arnie" title="Featured build" style="display:flex;align-items:center;padding:0 clamp(9px,1.3vw,13px);color:var(--faint);border-right:1px solid var(--line);letter-spacing:.05em;transition:color .2s ease,background .2s ease">01<span data-nav-lbl style="display:inline-block;max-width:0;opacity:0;overflow:hidden;white-space:nowrap;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;transition:max-width .35s cubic-bezier(.22,.7,.3,1),opacity .3s ease,margin-left .35s ease">Arnie</span></a>
            <a class="hover-nav" data-nav="work" href="#work" title="Case studies" style="display:flex;align-items:center;padding:0 clamp(9px,1.3vw,13px);color:var(--faint);border-right:1px solid var(--line);letter-spacing:.05em;transition:color .2s ease,background .2s ease">02<span data-nav-lbl style="display:inline-block;max-width:0;opacity:0;overflow:hidden;white-space:nowrap;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;transition:max-width .35s cubic-bezier(.22,.7,.3,1),opacity .3s ease,margin-left .35s ease">Case studies</span></a>
            <a class="hover-nav" data-nav="experience" href="#experience" title="Experience" style="display:flex;align-items:center;padding:0 clamp(9px,1.3vw,13px);color:var(--faint);border-right:1px solid var(--line);letter-spacing:.05em;transition:color .2s ease,background .2s ease">03<span data-nav-lbl style="display:inline-block;max-width:0;opacity:0;overflow:hidden;white-space:nowrap;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;transition:max-width .35s cubic-bezier(.22,.7,.3,1),opacity .3s ease,margin-left .35s ease">Experience</span></a>
            <a class="hover-nav" data-nav="stack" href="#stack" title="Stack" style="display:flex;align-items:center;padding:0 clamp(9px,1.3vw,13px);color:var(--faint);border-right:1px solid var(--line);letter-spacing:.05em;transition:color .2s ease,background .2s ease">04<span data-nav-lbl style="display:inline-block;max-width:0;opacity:0;overflow:hidden;white-space:nowrap;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;transition:max-width .35s cubic-bezier(.22,.7,.3,1),opacity .3s ease,margin-left .35s ease">Stack</span></a>
            <a class="hover-nav" data-nav="contact" href="#contact" title="Contact" style="display:flex;align-items:center;padding:0 clamp(9px,1.3vw,13px);color:var(--faint);letter-spacing:.05em;transition:color .2s ease,background .2s ease">05<span data-nav-lbl style="display:inline-block;max-width:0;opacity:0;overflow:hidden;white-space:nowrap;font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;transition:max-width .35s cubic-bezier(.22,.7,.3,1),opacity .3s ease,margin-left .35s ease">Contact</span></a>
          </nav>
          <div style="justify-self:end;display:flex;align-items:center">
            <button data-palette-btn type="button" aria-label="Search sections" title="Search sections (⌘K / Ctrl K)" data-cursor-hot class="hover-search" style="display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 10px 0 12px;border:1px solid var(--line-2);border-radius:10px;background:color-mix(in oklab,var(--bg-soft) 60%,transparent);color:var(--muted);font-family:var(--mono);font-size:11px;cursor:pointer;transition:border-color .15s,color .15s"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" style="flex:none"><circle cx="11" cy="11" r="7" style="stroke:currentColor;stroke-width:2"></circle><path d="M20 20 L16 16" style="stroke:currentColor;stroke-width:2"></path></svg><kbd data-kbd-hint style="font-family:var(--mono);font-size:10px;line-height:1;letter-spacing:.04em;padding:2px 5px;border:1px solid var(--line);border-radius:4px;background:color-mix(in oklab,var(--bg) 55%,transparent);color:var(--faint)">⌘K</kbd></button>
          </div>
        </div>
      </header>

      <main>
        <section id="top" data-screen-label="Hero" style="scroll-margin-top:76px;position:relative;max-width:1240px;margin:0 auto;padding:clamp(52px,10vh,104px) clamp(18px,5vw,56px) clamp(36px,6vh,60px);overflow:hidden">
          <div data-parallax="0.14" aria-hidden="true" style="position:absolute;inset:0;z-index:0;pointer-events:none">
            <svg viewBox="0 0 1440 760" preserveAspectRatio="xMidYMid slice" style="width:100%;height:100%">
              <line x1="300" y1="150" x2="470" y2="95" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="300" y1="150" x2="380" y2="310" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="470" y1="95" x2="560" y2="240" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="380" y1="310" x2="560" y2="240" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="560" y1="240" x2="610" y2="440" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="560" y1="240" x2="760" y2="150" style="stroke:var(--accent);stroke-width:1;opacity:.4;stroke-dasharray:5 11;animation:flow 2.8s linear infinite;animation-play-state:var(--node-play,running)"></line>
              <line x1="760" y1="150" x2="800" y2="350" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="610" y1="440" x2="800" y2="350" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="760" y1="150" x2="940" y2="250" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="800" y1="350" x2="940" y2="250" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="800" y1="350" x2="980" y2="470" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="940" y1="250" x2="1130" y2="160" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="940" y1="250" x2="1170" y2="380" style="stroke:var(--accent);stroke-width:1;opacity:.4;stroke-dasharray:5 11;animation:flow 3.4s linear infinite;animation-play-state:var(--node-play,running)"></line>
              <line x1="980" y1="470" x2="1170" y2="380" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="1130" y1="160" x2="1320" y2="270" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="1170" y1="380" x2="1320" y2="270" style="stroke:var(--accent);stroke-width:1;opacity:.4;stroke-dasharray:5 11;animation:flow 3.1s linear infinite;animation-play-state:var(--node-play,running)"></line>
              <line x1="1170" y1="380" x2="1250" y2="560" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="980" y1="470" x2="1080" y2="570" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="1250" y1="560" x2="1080" y2="570" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <line x1="1170" y1="380" x2="1080" y2="570" style="stroke:var(--accent);stroke-width:1;opacity:.15"></line>
              <circle cx="300" cy="150" r="3.2" style="fill:var(--accent);opacity:.3"></circle>
              <circle cx="380" cy="310" r="3.2" style="fill:var(--accent);opacity:.3"></circle>
              <circle cx="560" cy="240" r="3.6" style="fill:var(--accent);opacity:.4"></circle>
              <circle cx="610" cy="440" r="3" style="fill:var(--accent);opacity:.28"></circle>
              <circle cx="800" cy="350" r="3.6" style="fill:var(--accent);opacity:.4"></circle>
              <circle cx="980" cy="470" r="3.2" style="fill:var(--accent);opacity:.3"></circle>
              <circle cx="1130" cy="160" r="3.2" style="fill:var(--accent);opacity:.3"></circle>
              <circle cx="1320" cy="270" r="3.2" style="fill:var(--accent);opacity:.3"></circle>
              <circle cx="1250" cy="560" r="3" style="fill:var(--accent);opacity:.28"></circle>
              <circle cx="1080" cy="570" r="3" style="fill:var(--accent);opacity:.28"></circle>
              <circle cx="470" cy="95" r="6" style="fill:none;stroke:var(--accent);stroke-width:1.2;opacity:.5;transform-box:fill-box;transform-origin:center;animation:nodeRing 5.4s ease-in-out 0s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="470" cy="95" r="4.4" style="fill:var(--accent);opacity:.9;animation:nodeDot 5.4s ease-in-out 0s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="760" cy="150" r="6" style="fill:none;stroke:var(--accent);stroke-width:1.2;opacity:.5;transform-box:fill-box;transform-origin:center;animation:nodeRing 6.2s ease-in-out -1.6s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="760" cy="150" r="4.4" style="fill:var(--accent);opacity:.9;animation:nodeDot 6.2s ease-in-out -1.6s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="940" cy="250" r="6" style="fill:none;stroke:var(--accent);stroke-width:1.2;opacity:.5;transform-box:fill-box;transform-origin:center;animation:nodeRing 5.8s ease-in-out -3.1s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="940" cy="250" r="4.4" style="fill:var(--accent);opacity:.9;animation:nodeDot 5.8s ease-in-out -3.1s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="1170" cy="380" r="6" style="fill:none;stroke:var(--accent);stroke-width:1.2;opacity:.5;transform-box:fill-box;transform-origin:center;animation:nodeRing 6.6s ease-in-out -.8s infinite;animation-play-state:var(--node-play,running)"></circle>
              <circle cx="1170" cy="380" r="4.4" style="fill:var(--accent);opacity:.9;animation:nodeDot 6.6s ease-in-out -.8s infinite;animation-play-state:var(--node-play,running)"></circle>
            </svg>
            <div style="position:absolute;inset:0;background:linear-gradient(90deg,var(--bg) 10%,color-mix(in oklab,var(--bg) 60%,transparent) 46%,transparent 80%),linear-gradient(0deg,var(--bg),transparent 42%)"></div>
          </div>

          <div data-stagger="up" data-stagger-step="95" style="position:relative;z-index:1;max-width:920px">
            <div style="display:inline-flex;align-items:center;gap:11px;font-family:var(--mono);font-size:12px;letter-spacing:.2em;color:var(--faint);text-transform:uppercase;margin-bottom:var(--sp-eyebrow)">
              <span style="width:22px;height:1px;background:var(--accent)"></span>AI Integration Engineer · Founder
            </div>
            <h1 style="margin:0;font-size:clamp(46px,8.5vw,102px);font-weight:600;letter-spacing:-.03em;line-height:.92">Mauro Genna</h1>
            <p style="margin:var(--sp-lead) 0 0;font-size:clamp(20px,3vw,31px);font-weight:400;line-height:1.34;color:var(--ink);max-width:840px">I ship <span style="color:var(--accent)">production AI systems</span> — agentic assistants, RAG pipelines and voice automation — inside real SaaS products. Founder of <span style="color:var(--accent)">Arnie</span>.</p>
            <p style="margin:var(--sp-para) 0 0;font-size:clamp(15px,1.6vw,17px);line-height:1.62;color:var(--muted);max-width:62ch">I design and ship end-to-end systems — backend to frontend — with strong ownership over architecture, scalability and revenue-critical features. The AI goes to production with real permission boundaries, not as a demo.</p>
            <div style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 22px;margin-top:30px;font-family:var(--mono);font-size:12.5px;color:var(--muted)">
              <span style="display:inline-flex;align-items:center;gap:9px"><span style="width:8px;height:8px;border-radius:50%;background:#3fe08a;box-shadow:0 0 0 3px color-mix(in oklab,#3fe08a 20%,transparent);animation:statusBlink 2.4s ease-in-out infinite;animation-play-state:var(--node-play,running)"></span>Available for remote roles</span>
              <span style="color:var(--faint)">US / EU timezones</span>
              <span style="color:var(--faint)">EN · ES · IT</span>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:26px">
              <a class="hover-primary" href="#contact" style="display:inline-flex;align-items:center;gap:9px;padding:12px 20px;border-radius:9px;background:var(--accent);color:#06121f;font-weight:600;font-size:14.5px;border:1px solid var(--accent)">Get in touch <span style="font-family:var(--mono)">→</span></a>
              <a class="hover-ghost" href="https://github.com/maurogenna23" target="_blank" rel="noopener" style="padding:12px 18px;border:1px solid var(--line-2);border-radius:9px;color:var(--muted);font-family:var(--mono);font-size:13px">GitHub ↗</a>
              <a class="hover-ghost" href="https://www.linkedin.com/in/maurogenna" target="_blank" rel="noopener" style="padding:12px 18px;border:1px solid var(--line-2);border-radius:9px;color:var(--muted);font-family:var(--mono);font-size:13px">LinkedIn ↗</a>
            </div>
          </div>
        </section>

        <section id="arnie" data-screen-label="Featured build — Arnie" style="scroll-margin-top:76px;max-width:1180px;margin:0 auto;padding:clamp(40px,7vh,72px) clamp(18px,5vw,56px)">
          <div data-reveal="up" style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--faint)"><span style="color:var(--accent)">01</span><span style="width:26px;height:1px;background:var(--line-2)"></span><span>Featured build</span></div>
          <div style="display:flex;flex-wrap:wrap;gap:clamp(28px,4vw,52px);align-items:stretch;margin-top:var(--sp-block)">
            <div data-reveal="left" style="flex:1 1 340px;min-width:290px">
              <div style="display:flex;align-items:center;gap:16px">
                <img src="/arnie-logo.png" alt="Arnie logo" width="60" height="60" style="width:60px;height:60px;border-radius:14px;border:1px solid var(--line-2)" />
                <div><div style="font-size:30px;font-weight:600;letter-spacing:-.01em">Arnie</div><div style="font-family:var(--mono);font-size:11.5px;color:var(--faint);letter-spacing:.08em;margin-top:2px">FOUNDER · 2026 → NOW</div></div>
              </div>
              <p style="font-size:19px;line-height:1.4;margin:var(--sp-lead) 0 0;color:var(--ink)">24/7 AI customer support for small and medium businesses.</p>
              <p style="font-size:15.5px;line-height:1.64;color:var(--muted);margin:var(--sp-para) 0 0">Arnie answers customers across WhatsApp, voice, and web chat — so businesses that can't staff a round-the-clock team never miss a conversation. Built for local retailers, service businesses, and real-estate agencies across Latin America.</p>
              <ul style="list-style:none;margin:20px 0 0;padding:0;display:flex;flex-direction:column;gap:9px">
                <li style="display:flex;gap:10px;font-family:var(--mono);font-size:12.5px;line-height:1.5;color:var(--muted)"><span style="flex:none;margin-top:6px;width:5px;height:5px;border-radius:50%;background:var(--accent)"></span><span>Shared context engine across chat and voice — PDF and website ingestion, chunking, Postgres full-text + trigram retrieval</span></li>
                <li style="display:flex;gap:10px;font-family:var(--mono);font-size:12.5px;line-height:1.5;color:var(--muted)"><span style="flex:none;margin-top:6px;width:5px;height:5px;border-radius:50%;background:var(--accent)"></span><span>Per-tenant data isolation across client companies</span></li>
                <li style="display:flex;gap:10px;font-family:var(--mono);font-size:12.5px;line-height:1.5;color:var(--muted)"><span style="flex:none;margin-top:6px;width:5px;height:5px;border-radius:50%;background:var(--accent)"></span><span>Agents that execute real actions via function calling, not just respond</span></li>
              </ul>
              <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:20px">
                <span style="display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:20px;padding:6px 13px"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent)"></span>WhatsApp</span>
                <span style="display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:20px;padding:6px 13px"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent)"></span>Voice</span>
                <span style="display:inline-flex;align-items:center;gap:7px;font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:20px;padding:6px 13px"><span style="width:6px;height:6px;border-radius:50%;background:var(--accent)"></span>Web chat</span>
              </div>
              <div style="margin-top:22px">
                <div style="font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:var(--faint);text-transform:uppercase;margin-bottom:10px">Built with</div>
                <div style="display:flex;flex-wrap:wrap;gap:7px">
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">TypeScript</span>
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">NestJS</span>
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">Next.js</span>
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">PostgreSQL</span>
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">OpenAI</span>
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">Retell AI</span>
                  <span style="font-family:var(--mono);font-size:12px;color:var(--muted);border:1px solid var(--line);border-radius:6px;padding:5px 9px">ElevenLabs</span>
                </div>
              </div>
            </div>
            <div data-reveal="right" style="flex:1 1 420px;min-width:290px;display:flex;flex-direction:column">
