<script>
  // ------------------------------------------------------------------
  // Portfolio behaviour — vanilla port of the prototype's DCLogic class.
  // Scroll-spy nav, reveal-on-scroll, staggered children, hero parallax,
  // magnetic buttons, reticle cursor, architecture-diagram draw-in,
  // terminal boot sequence, command palette (⌘K) and copy-to-clipboard.
  // ------------------------------------------------------------------
  const root = document.querySelector<HTMLElement>('[data-portfolio-root]');
  if (root) initPortfolio(root);

  function initPortfolio(root: HTMLElement) {
    const EASE = 'cubic-bezier(.22,.7,.3,1)';
    const prefersReduced = () =>
      !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
    const motionEnabled = () => !prefersReduced();

    const bootEl = root.querySelector<HTMLElement>('[data-boot]');
    const cursorEl = root.querySelector<HTMLElement>('[data-cursor]');
    const paletteEl = root.querySelector<HTMLElement>('[data-palette]');
    const paletteInput = root.querySelector<HTMLInputElement>('[data-palette-input]');
    const paletteBtn = root.querySelector<HTMLElement>('[data-palette-btn]');

    const s: Record<string, any> = {
      bootActive: false,
      bootDone: false,
      revealPending: false,
      revealIo: null,
      revealEls: null,
      revealFallback: null,
      bootTimers: [],
      pOpen: false,
      activeIdx: 0,
    };

    // ---------- Scroll spy ----------
    function setupSpy() {
      const ids = ['top', 'arnie', 'work', 'experience', 'stack', 'contact'];
      const links = Array.from(root.querySelectorAll<HTMLElement>('[data-nav]'));
      const setActive = (id: string) => {
        links.forEach((a) => {
          const on = a.getAttribute('data-nav') === id;
          a.style.color = on ? 'var(--accent)' : 'var(--faint)';
          a.style.background = on ? 'color-mix(in oklab,var(--accent) 15%,transparent)' : 'transparent';
          const lbl = a.querySelector<HTMLElement>('[data-nav-lbl]');
          if (lbl) {
            lbl.style.maxWidth = on ? '160px' : '0px';
            lbl.style.opacity = on ? '1' : '0';
            lbl.style.marginLeft = on ? '7px' : '0px';
          }
        });
      };
      const sections = ids.map((id) => root.querySelector('#' + id)).filter(Boolean) as HTMLElement[];
      let ticking = false;
      let current: string | null = null;
      const pick = () => {
        ticking = false;
        const line = window.innerHeight * 0.32;
        let activeId = 'top';
        for (let i = 0; i < sections.length; i++) {
          if (sections[i].getBoundingClientRect().top - line <= 0) activeId = sections[i].id;
        }
        if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4)
          activeId = ids[ids.length - 1];
        if (activeId !== current) {
          current = activeId;
          setActive(activeId);
        }
      };
      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(pick);
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      pick();
    }

    // ---------- Reveal on scroll ----------
    function hiddenTransform(dir: string) {
      switch (dir) {
        case 'left': return 'translate3d(-44px,0,0)';
        case 'right': return 'translate3d(44px,0,0)';
        case 'down': return 'translate3d(0,-26px,0)';
        case 'scale': return 'scale(.93)';
        case 'up-scale': return 'translate3d(0,28px,0) scale(.975)';
        case 'grow-y': return 'scaleY(0)';
        default: return 'translate3d(0,30px,0)';
      }
    }
    function setupReveal() {
      Array.from(root.querySelectorAll<HTMLElement>('[data-stagger]')).forEach((c) => {
        const step = parseInt(c.getAttribute('data-stagger-step') || '85', 10);
        const dir = c.getAttribute('data-stagger') || 'up';
        Array.from(c.children).forEach((child, i) => {
          const el = child as HTMLElement;
          if (!el.hasAttribute('data-reveal')) el.setAttribute('data-reveal', dir);
          if (!el.hasAttribute('data-reveal-delay')) el.setAttribute('data-reveal-delay', String(i * step));
        });
      });

      const els = Array.from(root.querySelectorAll<HTMLElement>('[data-reveal]'));
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) return;

      els.forEach((el) => {
        const dir = el.getAttribute('data-reveal') || 'up';
        const dur = el.getAttribute('data-reveal-dur') || '700';
        const delay = el.getAttribute('data-reveal-delay') || '0';
        if (dir === 'grow-y') el.style.transformOrigin = 'top center';
        el.style.transition =
          'opacity ' + dur + 'ms ' + EASE + ' ' + delay + 'ms, transform ' + dur + 'ms ' + EASE + ' ' + delay + 'ms';
        el.style.opacity = dir === 'grow-y' ? '1' : '0';
        el.style.transform = hiddenTransform(dir);
        el.style.willChange = 'transform, opacity';
      });

      s.revealIo = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            const el = e.target as HTMLElement;
            el.style.opacity = '1';
            el.style.transform = 'none';
            setTimeout(() => (el.style.willChange = 'auto'), 1300);
            s.revealIo.unobserve(el);
          });
        },
        { rootMargin: '0px 0px -10% 0px', threshold: 0.12 }
      );
      s.revealEls = els;

      if (s.bootActive) {
        s.revealPending = true;
        s.revealFallback = setTimeout(() => startReveal(), 3200);
      } else {
        els.forEach((el) => s.revealIo.observe(el));
      }
    }
    function startReveal() {
      if (!s.revealPending || !s.revealIo || !s.revealEls) return;
      s.revealPending = false;
      clearTimeout(s.revealFallback);
      s.revealEls.forEach((el: HTMLElement) => s.revealIo.observe(el));
    }

    // ---------- Parallax ----------
    function setupParallax() {
      const nodes = Array.from(root.querySelectorAll<HTMLElement>('[data-parallax]')).map((el) => {
        el.style.willChange = 'transform';
        return { el, k: parseFloat(el.getAttribute('data-parallax') || '') || 0.14 };
      });
      if (!nodes.length) return;
      let ticking = false;
      const update = () => {
        const y = window.scrollY || window.pageYOffset || 0;
        nodes.forEach(({ el, k }) => {
          el.style.transform = 'translate3d(0,' + (y * k).toFixed(1) + 'px,0)';
        });
        ticking = false;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!ticking) {
            ticking = true;
            requestAnimationFrame(update);
          }
        },
        { passive: true }
      );
      update();
    }

    // ---------- Reticle cursor ----------
    function cursorEnabled() {
      return !!(window.matchMedia && window.matchMedia('(pointer:fine)').matches);
    }
    function setupCursor() {
      if (!cursorEl || !cursorEnabled()) return;
      Array.from(root.querySelectorAll<HTMLElement>('#stack [data-stagger] > div')).forEach((c) =>
        c.setAttribute('data-cursor-hot', '')
      );
      root.setAttribute('data-cursor-on', '');
      const svg = cursorEl.querySelector<HTMLElement>('[data-cursor-svg]');
      const ring = cursorEl.querySelector<HTMLElement>('[data-cursor-ring]');
      const HOT = 'a,button,input,textarea,select,article,[data-cursor-hot]';
      let x = window.innerWidth / 2;
      let y = window.innerHeight / 2;
      let hot = false;
      let raf = 0;
      const draw = () => {
        raf = 0;
        cursorEl.style.transform = 'translate(' + x + 'px,' + y + 'px)';
      };
      window.addEventListener(
        'pointermove',
        (e) => {
          x = e.clientX;
          y = e.clientY;
          if (cursorEl.style.opacity !== '1') cursorEl.style.opacity = '1';
          if (!raf) raf = requestAnimationFrame(draw);
          const t = e.target as HTMLElement;
          const isHot = !!(t && t.closest && t.closest(HOT));
          if (isHot !== hot) {
            hot = isHot;
            if (svg) svg.style.transform = hot ? 'scale(1.55)' : 'scale(1)';
            if (ring) ring.style.opacity = hot ? '1' : '0';
            cursorEl.style.color = hot ? 'color-mix(in oklab,var(--accent) 45%,#ffffff)' : 'var(--accent)';
          }
        },
        { passive: true }
      );
      document.addEventListener('mouseout', (e: MouseEvent) => {
        if (!e.relatedTarget) cursorEl.style.opacity = '0';
      });
    }

    // ---------- Magnetic buttons ----------
    function setupMagnetic() {
      if (prefersReduced()) return;
      const sel =
        '#top a[href="#contact"],#top a[href*="github"],#top a[href*="linkedin"],#contact button,#contact a[href*="github"],#contact a[href*="linkedin"],#contact a[href$=".pdf"]';
      const els = Array.from(root.querySelectorAll<HTMLElement>(sel));
      const MAX = 7;
      const K = 0.28;
      els.forEach((el) => {
        let base: DOMRect | null = null;
        el.addEventListener('pointerenter', () => {
          el.style.transition = 'transform .2s ' + EASE;
          el.style.willChange = 'transform';
          base = el.getBoundingClientRect();
        });
        el.addEventListener('pointermove', (e) => {
          if (!base) base = el.getBoundingClientRect();
          const dx = e.clientX - (base.left + base.width / 2);
          const dy = e.clientY - (base.top + base.height / 2);
          const tx = Math.max(-MAX, Math.min(MAX, dx * K));
          const ty = Math.max(-MAX, Math.min(MAX, dy * K));
          el.style.transform = 'translate(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px) scale(1.04)';
        });
        el.addEventListener('pointerleave', () => {
          el.style.transform = 'translate(0,0) scale(1)';
          el.style.willChange = 'auto';
          base = null;
        });
      });
    }

    // ---------- Architecture diagrams ----------
    function setupDiagrams() {
      const rows = Array.from(root.querySelectorAll<HTMLElement>('[data-arch]'));
      if (!rows.length) return;
      const parsed = rows.map((row) => {
        const kids = Array.from(row.children) as HTMLElement[];
        const boxes = kids.filter((k) => !k.querySelector('svg'));
        const links = kids.filter((k) => k.querySelector('svg'));
        boxes.forEach((b) => b.setAttribute('data-arch-box', ''));
        links.forEach((l) => l.setAttribute('data-arch-link', ''));
        return { row, boxes, links };
      });
      if (!motionEnabled()) return;
      parsed.forEach((p) => {
        p.boxes.forEach((b) => {
          b.style.opacity = '0';
          b.style.transform = 'translateY(16px) scale(.955)';
          b.style.willChange = 'opacity,transform';
        });
        p.links.forEach((l) => {
          const ps = l.querySelectorAll<SVGPathElement>('path');
          if (ps[0]) {
            ps[0].style.strokeDasharray = '34';
            ps[0].style.strokeDashoffset = '34';
          }
          if (ps[1]) ps[1].style.opacity = '0';
        });
      });
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            io.unobserve(e.target);
            const item = parsed.find((p) => p.row === e.target);
            if (!item) return;
            const { boxes, links } = item;
            const STEP = 150;
            const DUR = 460;
            boxes.forEach((b, i) =>
              setTimeout(() => {
                b.style.transition = 'opacity ' + DUR + 'ms ' + EASE + ', transform ' + DUR + 'ms ' + EASE;
                b.style.opacity = '1';
                b.style.transform = 'none';
              }, i * STEP)
            );
            const linkStart = boxes.length * STEP + 140;
            links.forEach((l, i) =>
              setTimeout(() => {
                const ps = l.querySelectorAll<SVGPathElement>('path');
                if (ps[0]) {
                  ps[0].style.transition = 'stroke-dashoffset .42s ' + EASE;
                  ps[0].style.strokeDashoffset = '0';
                }
                if (ps[1])
                  setTimeout(() => {
                    ps[1].style.transition = 'opacity .22s ease';
                    ps[1].style.opacity = '1';
                  }, 280);
              }, linkStart + i * 170)
            );
            setTimeout(() => {
              boxes.forEach((b) => {
                b.style.willChange = 'auto';
                b.style.transition = '';
                b.style.transform = '';
              });
            }, linkStart + links.length * 170 + 900);
          });
        },
        { rootMargin: '0px 0px -12% 0px', threshold: 0.25 }
      );
      parsed.forEach((p) => io.observe(p.row));
    }

    // ---------- Boot sequence ----------
    function initBoot() {
      if (!bootEl) return;
      let seen = false;
      try {
        seen = sessionStorage.getItem('mg-boot') === '1';
      } catch (e) {}
      if (seen || !motionEnabled()) {
        bootEl.style.display = 'none';
        return;
      }
      startBoot();
    }
    function startBoot() {
      if (!bootEl) return;
      s.bootActive = true;
      s.bootTimers = [];
      const lines = Array.from(bootEl.querySelectorAll<HTMLElement>('[data-boot-line]'));
      const texts = ['> initializing_portfolio...', '> loading_systems...', '> mauro_genna.connect()', '> ready.'];
      const caret = document.createElement('span');
      caret.style.cssText =
        'display:inline-block;width:.55em;height:1.02em;vertical-align:-.15em;margin-left:3px;background:var(--accent);animation:bootCaret .8s step-end infinite';
      const CH = 14;
      const GAP = 55;
      const HOLD = 150;
      let li = 0;
      let ci = 0;
      const tick = () => {
        if (s.bootDone) return;
        if (li >= texts.length) {
          s.bootTimers.push(setTimeout(() => finishBoot(false), HOLD));
          return;
        }
        const el = lines[li];
        if (!el) {
          li++;
          ci = 0;
          tick();
          return;
        }
        if (ci === 0) {
          el.textContent = '';
          el.appendChild(caret);
        }
        if (ci < texts[li].length) {
          caret.insertAdjacentText('beforebegin', texts[li].charAt(ci));
          ci++;
          s.bootTimers.push(setTimeout(tick, CH));
        } else {
          li++;
          ci = 0;
          s.bootTimers.push(setTimeout(tick, GAP));
        }
      };
      s.bootSkip = () => finishBoot(true);
      window.addEventListener('keydown', s.bootSkip);
      window.addEventListener('pointerdown', s.bootSkip);
      tick();
    }
    function finishBoot(skipped: boolean) {
      if (s.bootDone) return;
      s.bootDone = true;
      s.bootActive = false;
      (s.bootTimers || []).forEach((t: number) => clearTimeout(t));
      s.bootTimers = [];
      if (s.bootSkip) {
        window.removeEventListener('keydown', s.bootSkip);
        window.removeEventListener('pointerdown', s.bootSkip);
        s.bootSkip = null;
      }
      try {
        sessionStorage.setItem('mg-boot', '1');
      } catch (e) {}
      if (!bootEl) return;
      if (skipped) {
        const lines = Array.from(bootEl.querySelectorAll<HTMLElement>('[data-boot-line]'));
        const texts = ['> initializing_portfolio...', '> loading_systems...', '> mauro_genna.connect()', '> ready.'];
        lines.forEach((el, i) => (el.textContent = texts[i] || ''));
      }
      bootEl.style.opacity = '0';
      bootEl.style.transform = 'scale(1.06)';
      bootEl.style.pointerEvents = 'none';
      setTimeout(() => startReveal(), 140);
      setTimeout(() => {
        if (bootEl) bootEl.style.display = 'none';
      }, 460);
    }

    // ---------- Command palette ----------
    function paletteItems() {
      return paletteEl ? Array.from(paletteEl.querySelectorAll<HTMLElement>('[data-palette-item]')) : [];
    }
    function visibleItems() {
      return paletteItems().filter((el) => el.style.display !== 'none');
    }
    function setActiveItem(i: number) {
      const vis = visibleItems();
      if (!vis.length) {
        s.activeIdx = -1;
        return;
      }
      s.activeIdx = Math.max(0, Math.min(i, vis.length - 1));
      const active = vis[s.activeIdx];
      paletteItems().forEach((el) => {
        const on = el === active;
        el.style.background = on ? 'color-mix(in oklab,var(--accent) 14%,transparent)' : 'transparent';
        el.style.color = on ? 'var(--ink)' : 'var(--muted)';
        el.setAttribute('aria-selected', on ? 'true' : 'false');
        const go = el.querySelector<HTMLElement>('[data-go]');
        if (go) go.style.opacity = on ? '1' : '0';
      });
    }
    function moveActive(d: number) {
      setActiveItem((s.activeIdx || 0) + d);
    }
    function activateActive() {
      const vis = visibleItems();
      const el = vis[s.activeIdx || 0];
      if (el) go(el.getAttribute('data-target'));
    }
    function go(target: string | null) {
      closePalette();
      if (target) {
        try {
          location.hash = '#' + target;
        } catch (e) {}
      }
    }
    function filterPalette(q: string) {
      q = (q || '').trim().toLowerCase();
      paletteItems().forEach((el) => {
        const hay = ((el.getAttribute('data-terms') || '') + ' ' + (el.textContent || '')).toLowerCase();
        el.style.display = !q || hay.indexOf(q) !== -1 ? 'flex' : 'none';
      });
      setActiveItem(0);
    }
    function togglePalette() {
      if (s.pOpen) closePalette();
      else openPalette();
    }
    function openPalette() {
      if (!paletteEl) return;
      s.pOpen = true;
      paletteEl.style.display = 'flex';
      const panel = paletteEl.firstElementChild as HTMLElement;
      if (paletteInput) paletteInput.value = '';
      filterPalette('');
      requestAnimationFrame(() => {
        paletteEl.style.opacity = '1';
        if (panel) panel.style.transform = 'translateY(0)';
        if (paletteInput) {
          try {
            paletteInput.focus();
          } catch (e) {}
        }
      });
    }
    function closePalette() {
      if (!paletteEl) return;
      s.pOpen = false;
      const panel = paletteEl.firstElementChild as HTMLElement;
      paletteEl.style.opacity = '0';
      if (panel) panel.style.transform = 'translateY(-6px)';
      clearTimeout(s.pT);
      s.pT = setTimeout(() => (paletteEl.style.display = 'none'), 200);
      if (paletteBtn) {
        try {
          paletteBtn.focus();
        } catch (e) {}
      }
    }
    function setupPalette() {
      const isMac = /mac|iphone|ipad|ipod/i.test((navigator.platform || '') + ' ' + (navigator.userAgent || ''));
      Array.from(root.querySelectorAll<HTMLElement>('[data-kbd-hint]')).forEach(
        (k) => (k.textContent = isMac ? '⌘K' : 'Ctrl K')
      );
      document.addEventListener('keydown', (e) => {
        if (s.bootActive) return;
        const k = (e.key || '').toLowerCase();
        if (k === 'k' && (e.metaKey || e.ctrlKey)) {
          e.preventDefault();
          togglePalette();
          return;
        }
        if (k === 'escape' && s.pOpen) {
          e.preventDefault();
          closePalette();
        }
      });
      if (paletteInput) {
        paletteInput.addEventListener('keydown', (e) => {
          const k = (e.key || '').toLowerCase();
          if (k === 'arrowdown') {
            e.preventDefault();
            moveActive(1);
          } else if (k === 'arrowup') {
            e.preventDefault();
            moveActive(-1);
          } else if (k === 'enter') {
            e.preventDefault();
            activateActive();
          }
        });
        paletteInput.addEventListener('input', (e) => filterPalette((e.target as HTMLInputElement).value));
      }
      if (paletteBtn) paletteBtn.addEventListener('click', openPalette);
      paletteItems().forEach((el) =>
        el.addEventListener('click', () => go(el.getAttribute('data-target')))
      );
      if (paletteEl)
        paletteEl.addEventListener('click', (e) => {
          if (e.target === paletteEl) closePalette();
        });
    }

    // ---------- Copy email ----------
    function setupCopyEmail() {
      const btn = root.querySelector<HTMLElement>('[data-copy-email]');
      const hint = root.querySelector<HTMLElement>('[data-copy-hint]');
      if (!btn) return;
      let t: number;
      btn.addEventListener('click', () => {
        try {
          if (navigator.clipboard) navigator.clipboard.writeText('gennamauro18@gmail.com');
        } catch (e) {}
        if (hint) hint.textContent = 'Copied ✔';
        clearTimeout(t);
        t = window.setTimeout(() => {
          if (hint) hint.textContent = 'Click to copy';
        }, 1900);
      });
    }

    // ---------- Boot everything ----------
    setupSpy();
    setupPalette();
    setupCopyEmail();
    setupCursor();
    initBoot();
    setupDiagrams();
    if (motionEnabled()) {
      Array.from(root.querySelectorAll<HTMLElement>('#work article')).forEach((a, i) =>
        a.setAttribute('data-reveal', i % 2 ? 'right' : 'left')
      );
      setupReveal();
      setupParallax();
      setupMagnetic();
    }
  }
</script>
