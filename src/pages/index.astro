---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import arnieLogo from '../assets/arnie-logo.webp';
import arnieAssistant from '../assets/arnie-assistant.webp';
import arnieDashboard from '../assets/arnie-dashboard.webp';
import arnieAnalytics from '../assets/arnie-analytics.webp';

const cases = [
  {
    id: 'multi-agent',
    meta: 'Software Engineer · Highpoint Growth Networks · AI systems · 2024–2026',
    title: 'Giving four AI assistants write access to one production database',
    problem:
      'Four different user types — venues, advertisers, admins and internal messaging — needed AI assistance over the same production database, on a platform running across thousands of active screens and hundreds of venues and advertisers. Permissions and context differed radically per role, and a single assistant with direct write access was not acceptable: a hallucinating model could corrupt billing records or leak data across accounts.',
    decision:
      'A role-based multi-agent system built on OpenAI function calling, where each role exposes its own scoped toolset. The core pattern is propose/execute: the model never writes to the database — it produces a structured proposal that a human confirms before execution. For admin reporting, a scoped read-only SQL sandbox allows arbitrary queries with zero write surface.',
    outcome:
      'AI assistants running in production against real customer data with no unauthorized writes.',
    result:
      "The propose/execute pattern became the team's default for any AI-driven feature touching persistent state.",
    stack: 'OpenAI function calling · NestJS · Next.js · PostgreSQL',
    figure: {
      q: 'Where does the model stop and a person take over?',
      steps: [
        { k: 'Request', v: 'Scoped to the role that made it' },
        { k: 'Model', v: 'Reasons over that role’s toolset only' },
        { k: 'Proposes', v: 'A structured change. No write happens.', tone: 'propose' },
        { k: 'Human confirms', v: 'A person approves the proposal' },
        { k: 'Executes', v: 'The write is committed', tone: 'execute' },
      ],
      caption:
        "The model's output is a proposal, never a write. Every change to persistent state passes through a human approval before it is committed.",
    },
  },
  {
    id: 'billing',
    meta: 'Software Engineer · Highpoint Growth Networks · Billing · 2024–2026',
    title: 'Moving billing ownership in-house without dropping a subscription',
    problem:
      "Customers were billed through an external processor, but Captiview — Highpoint's ad-tech platform — held no record of it. The client wanted billing to run inside Captiview while keeping the processor underneath. The obstacle was that both systems already held records for the same customers and disagreed: an account Captiview showed as onboarded in August had existed in the processor since March. There was no shared key between them.",
    decision:
      "Rather than reconciling by hand or trusting one side, I built a system to do it: pull every customer from the processor, match each one to its Captiview account, and compare them field by field so conflicts surfaced instead of being averaged away. Where the two disagreed, Captiview won — its record was the newer one — and that rule was fixed before the first record moved, not decided case by case. The processor's customer ID was then stored on the Captiview account permanently, so every invoice pulled afterwards attached itself to the right customer.",
    outcome: 'Hundreds of active subscriptions integrated with zero disruption to existing customers.',
    result:
      "Captiview became the system of record for every subscription, with the full invoice history attached to the customer it belonged to instead of living in a third-party interface.",
    stack: 'NestJS · PostgreSQL · Payment processor API · Data reconciliation',
    link: { href: 'https://www.captiview.com/', label: 'The platform: captiview.com' },
    figure: {
      q: 'Two systems held the same customer and disagreed. Which one was right?',
      steps: [
        { k: 'Pull', v: 'Every customer record out of the processor' },
        { k: 'Match', v: 'Each one to its account inside Captiview' },
        { k: 'Compare', v: 'Field by field, so conflicts surface', tone: 'propose' },
        { k: 'Resolve', v: 'Captiview wins — its record is the newer one', tone: 'execute' },
        { k: 'Link', v: "The processor's ID kept on the account, so invoices land on the right customer" },
      ],
      caption:
        'The two systems shared no key and disagreed on dates. Fixing the rule before the first record moved turned hundreds of individual judgement calls into one decision made once.',
    },
  },
  {
    id: 'voice',
    meta: 'Full Stack Engineer · UseTeam · Voice AI · 2025 → now',
    title: 'Turning resident phone calls into structured, routed records',
    problem:
      "The building owner took the incident calls himself and could not answer them all. Residents reported by phone, in their own words and at any hour, so reports arrived incomplete or never arrived — and nothing kept a consistent record of what had been said or when.",
    decision:
      "A voice agent on Retell AI that runs an interview rather than a transcription. It asks what happened, how long ago, and whether the caller is on site, and does not close until it has all three. The answers become a categorised incident written to the system, and the owner is notified with the category already applied. Each call is recorded and scored for tone, so the owner can see whether the person was calm, nervous or angry before deciding what to handle first.",
    outcome: 'Deployed across 50+ residential communities in Spain.',
    result:
      "The owner stopped being the phone line. Every report is logged, categorised and delivered with the caller's state attached, without anyone answering or transcribing it by hand.",
    stack: 'Retell AI · NestJS · Next.js · Sentiment analysis',
    requirements: {
      q: 'What does the agent have to know before it can hang up?',
      label: 'Required before the call can close',
      items: ['What happened', 'How long ago', 'Whether the caller is on site'],
      gate: 'All three present — the incident is filed, categorised, and the owner notified.',
    },
  },
];

const notes = [
  {
    h: 'I start with the problem behind the request.',
    p: 'Before writing anything I want the workflow it sits in, the constraint that shaped it, and what the client is actually trying to achieve. Requests usually arrive as a solution someone already picked — the useful work is finding the problem it was meant to solve.',
  },
  {
    h: 'Ambiguity is the normal starting condition.',
    p: 'Requirements rarely arrive complete. I work with clients and stakeholders to turn them into something buildable, contributing to decisions about scope, technical approach, architecture, integrations, and what is worth doing first.',
  },
  {
    h: 'Design is a conversation, not a handoff.',
    p: "When there is a designer I want to be in the file before it is final — what is feasible, what will break, what is worth changing — and then build in parallel, adjusting together when the implementation shows something the mockup could not. When there is no designer, I own the UX and UI myself.",
  },
  {
    h: 'I own the whole path, not a slice of it.',
    p: 'Frontend, backend, database design, third-party integrations, AI systems, deployment. Owning the full path is what keeps the decisions at each layer consistent with the product decision that started them.',
  },
  {
    h: 'Shipping is the middle of the work.',
    p: 'Once something is in production I iterate on it — against stakeholder feedback and against how it actually gets used. That is usually where the real requirements show up.',
  },
];

const roles = [
  {
    when: 'May 2026 — Present',
    where: 'Remote · Argentina',
    title: 'Founder & Full Stack Engineer',
    org: 'Arnie',
    desc: 'Founded and built an AI support platform for SMBs, owning everything from problem discovery and customer conversations through architecture, implementation and go-to-market.',
  },
  {
    when: 'Apr 2025 — Present',
    where: 'Spain · Remote · Concurrent contract',
    title: 'Full Stack Engineer',
    org: 'UseTeam',
    desc: 'Lead AI-focused client projects from the first conversation through architecture, implementation and production delivery, in a team of four engineers shipping 5+ products for international clients.',
  },
  {
    when: 'Mar 2024 — Aug 2026',
    where: 'US · Remote · Concurrent contract',
    title: 'Software Engineer',
    org: 'Highpoint Growth Networks',
    desc: "Built features end to end across a production ad-tech SaaS — database, backend and frontend — in a team of five, and led the frontend itself: architecture and UX/UI, reworking the existing surface and directing the new one. Shipped the multi-agent AI system, and the migration that brought billing and its customers in-house from an external provider.",
  },
  {
    when: 'Apr 2023 — Mar 2024',
    where: 'Spain · Remote',
    title: 'Frontend Developer',
    org: 'Synergiart SL',
    desc: 'Built customer-facing web applications from Figma handoffs, owning each project from design handoff through to production.',
  },
];

const capabilities = [
  {
    name: 'Product engineering',
    what: 'Take a product from the first customer conversation to production — requirements discovery, stakeholder collaboration, technical decisions, delivery.',
    tech: 'End-to-end ownership · Client-facing development · MVP delivery',
  },
  {
    name: 'Interface',
    what: 'Own the UX and UI when there is no designer, and work from Figma with one when there is — starting at the feasibility conversation, not at the handoff.',
    tech: 'Design systems · Component architecture · Figma to production',
  },
  {
    name: 'AI products',
    what: 'Build agents that execute real business actions rather than only answering, and the retrieval layer that grounds them.',
    tech: 'OpenAI function calling · AI agents · LLM integrations · RAG · Retell AI · ElevenLabs',
  },
  {
    name: 'Full stack',
    what: 'Ship the whole surface, from data model to the interface a customer actually uses.',
    tech: 'TypeScript · React · Next.js · Node.js · NestJS · Tailwind · Zustand',
  },
  {
    name: 'Systems & data',
    what: 'Design the architecture and data model behind multi-tenant SaaS, subscriptions and payments.',
    tech: 'PostgreSQL · MongoDB · Technical architecture · Database design · Payment systems',
  },
];

// Generated at build time so the footer cannot go stale on its own.
const updated = new Date().toLocaleDateString('en-US', { month: 'long', year: 'numeric' });

const rows = [
  { k: 'Live product', v: 'www.arniechat.com', href: 'https://www.arniechat.com' },
  { k: 'Code', v: 'github.com/maurogenna23', href: 'https://github.com/maurogenna23' },
  { k: 'Profile', v: 'linkedin.com/in/maurogenna', href: 'https://www.linkedin.com/in/maurogenna' },
  { k: 'Résumé', v: 'Mauro_Genna_CV.pdf', href: '/Mauro_Genna_CV.pdf' },
];
---

<Layout>
  <a class="skip" href="#work">Skip to work</a>

  <header class="header">
    <div class="wrap header__inner">
      <a class="header__name" href="#top">Mauro Genna</a>
      <nav class="nav" aria-label="Sections">
        <a href="#work">Work</a>
        <a href="#approach">How I work</a>
        <a href="#experience">Experience</a>
        <a href="#capabilities">Capabilities</a>
        <a href="#contact">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <section class="wrap hero">
      <p class="hero__role">Product Engineer</p>
      <h1 class="display">
        I build AI-powered products from the first customer conversation to production.
      </h1>
      <p class="hero__sub">
        I work directly with clients and stakeholders to turn ambiguous requirements into something
        buildable — shaping scope, technical approach and architecture, then owning the
        implementation across frontend, backend, data and AI.
      </p>
      <p class="hero__sub">
        I founded Arnie and run it end to end. Before that I led AI-focused client projects at
        UseTeam in Spain, and shipped production features on an ad-tech platform at Highpoint Growth
        Networks in the US.
      </p>
      <div class="actions">
        <a class="action" href="#work">View selected work</a>
        <a class="action action--quiet" href="#contact">Get in touch</a>
      </div>
    </section>

    <section class="section" id="work">
      <div class="wrap">
        <h2 class="sec">Work</h2>

        <article class="case" data-reveal>
          <div class="case__brand">
            <Image
              class="case__logo"
              src={arnieLogo}
              alt="Arnie logo"
              widths={[36, 72, 108]}
              sizes="36px"
              loading="lazy"
            />
            <p class="case__meta">Founder · Own product · 2026 → now</p>
          </div>
          <h3 class="case__title">Arnie — 24/7 AI customer support for small and medium businesses</h3>
          <p class="case__outcome">
            Designed and built end to end, on my own — interface, backend, AI pipelines and the
            go-to-market around them.
          </p>
          <p class="case__intro">
            Arnie answers customers across WhatsApp, voice, and web chat — so businesses that can't
            staff a round-the-clock team never miss a conversation. Built for local retailers,
            service businesses, and real-estate agencies across Latin America.
          </p>
          <ul class="points">
            <li>
              Shared context engine across chat and voice — PDF and website ingestion, chunking,
              Postgres full-text + trigram retrieval
            </li>
            <li>Per-tenant data isolation across client companies</li>
            <li>Agents that execute real actions via function calling, not just respond</li>
          </ul>
          <p class="stack-line">
            TypeScript · NestJS · Next.js · PostgreSQL · OpenAI · Retell AI · ElevenLabs
          </p>
          <div class="gallery">
            <figure>
              <Image
                class="gallery__img"
                src={arnieAssistant}
                alt="Arnie's assistant configuration screen, with type, identity, personality, instructions and capabilities as five steps"
                widths={[480, 760, 1120, 1600, 2240]}
                sizes="(max-width: 760px) calc(100vw - 3rem), min(1120px, calc(100vw - 3rem))"
                loading="lazy"
              />
              <figcaption>
                Configuring an assistant. Five steps — type, identity, personality, instructions,
                capabilities — so a shop owner can set one up without knowing what a system prompt
                is.
              </figcaption>
            </figure>
            <div class="gallery__pair">
              <figure>
                <Image
                  class="gallery__img"
                  src={arnieDashboard}
                  alt="Arnie's dashboard, showing setup progress and call metrics"
                  widths={[360, 560, 720, 1120]}
                  sizes="(max-width: 760px) calc(100vw - 3rem), 560px"
                  loading="lazy"
                />
                <figcaption>
                  The dashboard answers "is it working?" before "how much?" — health first, then
                  the numbers, then the conversations themselves.
                </figcaption>
              </figure>
              <figure>
                <Image
                  class="gallery__img"
                  src={arnieAnalytics}
                  alt="Arnie's analytics screen, showing conversation volume and channel distribution"
                  widths={[360, 560, 720, 1120]}
                  sizes="(max-width: 760px) calc(100vw - 3rem), 560px"
                  loading="lazy"
                />
                <figcaption>
                  Analytics answers one question per card — what customers ask, which channel they
                  arrive on, how fast the assistant replies.
                </figcaption>
              </figure>
            </div>
          </div>
          <a class="case__link" href="https://www.arniechat.com" target="_blank" rel="noopener">
            www.arniechat.com<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </article>

        {
          cases.map((c) => (
            <article class="case" id={c.id} data-reveal>
              <p class="case__meta">{c.meta}</p>
              <h3 class="case__title">{c.title}</h3>
              <p class="case__outcome">{c.outcome}</p>
              <dl class="pdr">
                <dt>Problem</dt>
                <dd>{c.problem}</dd>
                <dt>Decision</dt>
                <dd>{c.decision}</dd>
                <dt>Result</dt>
                <dd>{c.result}</dd>
              </dl>

              {c.requirements && (
                <figure class="figure">
                  <p class="figure__q">{c.requirements.q}</p>
                  <div class="reqs">
                    <p class="reqs__k">{c.requirements.label}</p>
                    <ul class="reqs__list">
                      {c.requirements.items.map((i) => (
                        <li>{i}</li>
                      ))}
                    </ul>
                    <p class="reqs__gate">{c.requirements.gate}</p>
                  </div>
                </figure>
              )}

              {c.figure && (
                  <figure class="figure">
                    <p class="figure__q">{c.figure.q}</p>
                    <div class="chain">
                      {c.figure.steps.map((s) => (
                        <div class={s.tone ? `chain__step chain__step--${s.tone}` : 'chain__step'}>
                          <div class="chain__k">{s.k}</div>
                          <div class="chain__rule" />
                          <div class="chain__v">{s.v}</div>
                        </div>
                      ))}
                    </div>
                    <figcaption class="figure__caption">{c.figure.caption}</figcaption>
                  </figure>
                )}

              <p class="stack-line">{c.stack}</p>
              {c.link && (
                <a class="case__link" href={c.link.href} target="_blank" rel="noopener">
                  {c.link.label}
                  <span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
            </article>
          ))
        }
      </div>
    </section>

    <section class="section" id="approach">
      <div class="wrap">
        <h2 class="sec">How I work</h2>
        {
          notes.map((n) => (
            <div class="note" data-reveal>
              <p class="note__h">{n.h}</p>
              <p class="note__p">{n.p}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="experience">
      <div class="wrap">
        <h2 class="sec">Experience</h2>
        {
          roles.map((r) => (
            <div class="role" data-reveal>
              <div class="role__when">
                {r.when}
                <span class="role__where">{r.where}</span>
              </div>
              <div>
                <p class="role__title">
                  {r.title} <span class="role__org">· {r.org}</span>
                </p>
                <p class="role__desc">{r.desc}</p>
              </div>
            </div>
          ))
        }
        <p class="avail">
          Highpoint and UseTeam were independent contracts and ran concurrently. The UseTeam
          contract closes when I start somewhere full-time; Arnie stays live, in maintenance rather
          than active development.
        </p>
        <p class="edu">
          Full Stack Web Development — Henry (2023) · Frontend Development — NextU (2022)
        </p>
      </div>
    </section>

    <section class="section" id="capabilities">
      <div class="wrap">
        <h2 class="sec">Capabilities</h2>
        {
          capabilities.map((c) => (
            <div class="cap" data-reveal>
              <p class="cap__name">{c.name}</p>
              <div>
                <p class="cap__what">{c.what}</p>
                <p class="cap__tech">{c.tech}</p>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <section class="section" id="contact">
      <div class="wrap">
        <h2 class="sec">Contact</h2>
        <p class="lead">Currently open to Product Engineer roles.</p>
        <p class="prose contact__intro">
          If you are hiring for a role where one person owns the product decision and the code that
          follows from it, or you want to talk about Arnie for your business, write to me.
        </p>
        <a class="contact__email" href="mailto:gennamauro18@gmail.com">gennamauro18@gmail.com</a>

        <div class="rows">
          <div class="row">
            <span class="row__k">Setup</span>
            <span>Full-time · available now</span>
          </div>
          <div class="row">
            <span class="row__k">Markets</span>
            <span>US · EU timezones</span>
          </div>
          <div class="row">
            <span class="row__k">Languages</span>
            <span>Spanish native · English professional · Italian B1</span>
          </div>
          {
            rows.map((r) => (
              <a class="row" href={r.href} target="_blank" rel="noopener">
                <span class="row__k">{r.k}</span>
                <span>{r.v}<span class="sr-only"> (opens in a new tab)</span></span>
              </a>
            ))
          }
        </div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <span>© 2026 Mauro Genna · Product Engineer</span>
      <span>Astro · self-hosted Geist · updated {updated}</span>
    </div>
  </footer>
</Layout>

<script>
  /* One behaviour: mark a block as it enters the reading flow.
     Skipped under reduced-motion, and the hiding styles are gated
     behind `.reveal-ready`, so no-JS and reduced-motion visitors
     get the content already in place. */
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

  if (!reduce && 'IntersectionObserver' in window && targets.length) {
    document.documentElement.classList.add('reveal-ready');
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
