---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'Mauro Genna — Product Engineer | Full Stack & AI-Powered Products',
  description = 'Product Engineer building AI-powered products from the first customer conversation to production. Founder of Arnie. NestJS, Next.js, PostgreSQL, OpenAI.',
  image = '/og-mauro-genna.png',
  noindex = false,
} = Astro.props;

// Absolute URLs (require `site` in astro.config.mjs).
const site = Astro.site ?? new URL('https://maurogenna.dev');
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(image, site).href;

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mauro Genna',
  jobTitle: 'Product Engineer',
  description:
    'Product Engineer working across the full stack of AI-powered products — agentic function-calling assistants, RAG retrieval pipelines, voice automation, backend architecture and billing infrastructure. Founder of Arnie.',
  url: site.href,
  image: ogImage,
  email: 'mailto:gennamauro18@gmail.com',
  sameAs: [
    'https://github.com/maurogenna23',
    'https://www.linkedin.com/in/maurogenna',
  ],
  knowsLanguage: ['English', 'Spanish', 'Italian'],
  worksFor: {
    '@type': 'Organization',
    name: 'Arnie',
    url: 'https://www.arniechat.com',
  },
  knowsAbout: [
    'Product Engineering',
    'UX Design',
    'UI Design',
    'Design Systems',
    'Frontend Architecture',
    'TypeScript',
    'NestJS',
    'Node.js',
    'Next.js',
    'React',
    'PostgreSQL',
    'MongoDB',
    'OpenAI',
    'Retell AI',
    'Voice AI',
    'SaaS',
    'Billing systems',
    'Retrieval-Augmented Generation',
    'OpenAI Function Calling',
    'Agentic AI Systems',
    'Voice AI Pipelines',
    'WhatsApp Business API',
    'Multi-tenant SaaS',
    'Subscription Billing',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mauro Genna" />
    <meta name="theme-color" content="#faf8f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#17150f" media="(prefers-color-scheme: dark)" />
    <meta
      name="keywords"
      content="Mauro Genna, product engineer, full stack engineer, AI-powered products, AI engineer, RAG, function calling, agentic AI, voice AI engineer, LLM integration, founding engineer, AI SaaS, TypeScript, NestJS, Next.js, PostgreSQL, OpenAI, voice AI, Arnie"
    />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Mauro Genna" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content="Mauro Genna, Product Engineer — I build AI-powered products from the first customer conversation to production." />
    <meta property="og:locale" content="en_US" />
    <meta property="profile:first_name" content="Mauro" />
    <meta property="profile:last_name" content="Genna" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Fonts: self-hosted, preloaded so the text paints once. -->
    <link
      rel="preload"
      href="/fonts/geist-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <slot />
    <!-- Vercel Web Analytics. First-party: the script is served from this
         domain, so the page still makes no third-party requests. No cookies. -->
    <Analytics />
  </body>
</html>
